{
  "name": "@axiomantic/llmlingua-2",
  "version": "0.1.1",
  "description": "A TypeScript port of LLMLingua-2 prompt compression for Node.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "build": "npm run gen:version && tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "test:integration": "LLMLINGUA_INTEGRATION=1 vitest run tests/integration.test.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@huggingface/transformers": "^4.0.0",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "llmlingua",
    "llmlingua-2",
    "prompt-compression",
    "transformers",
    "huggingface",
    "onnx",
    "nlp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomantic/llmlingua-2"
  },
  "bugs": {
    "url": "https://github.com/axiomantic/llmlingua-2/issues"
  },
  "homepage": "https://github.com/axiomantic/llmlingua-2#readme"
}
